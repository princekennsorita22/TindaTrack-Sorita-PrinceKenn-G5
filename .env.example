# Copy this file to .env and fill in your own values. NEVER commit .env.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me

# Use True only on your own computer. Leave False anywhere else (no tracebacks shown).
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase: Project > Connect > "Session pooler" connection string (works on IPv4).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase needs SSL. Set to False only for a local PostgreSQL without SSL.
DB_SSL_REQUIRE=True

# On a deployed HTTPS server: send cookies over HTTPS only, and list your site's origin.
# SECURE_COOKIES=True
# CSRF_TRUSTED_ORIGINS=https://your-app.example.com
